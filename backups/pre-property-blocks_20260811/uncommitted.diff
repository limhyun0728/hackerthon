+    trainable = [(name, p) for name, p in model.named_parameters() if p.requires_grad]
+    fresh = set(missing_keys)
+    old_positions = [index for index, (name, _) in enumerate(trainable) if name not in fresh]
+    saved_groups = list(saved_state.get("param_groups") or ())
+    if len(saved_groups) != 1:
+        raise ValueError(f"param group이 1개일 때만 이어붙일 수 있다 (저장본 {len(saved_groups)}개)")
+    saved_params = list(saved_groups[0]["params"])
+    if len(old_positions) != len(saved_params):
+        raise ValueError(
+            "optimizer state를 이어붙일 수 없다: 저장된 파라미터 "
+            f"{len(saved_params)}개인데 이어받을 자리는 {len(old_positions)}개다. "
+            "파라미터가 추가만 된 게 아니라 제거·재배치됐을 수 있다"
+        )
