+def _resume_world_model_optimizer(
+    optimizer: torch.optim.Optimizer,
+    model: torch.nn.Module,
+    saved_state: Mapping[str, object],
+    missing_keys: Iterable[str],
+) -> int:
+    """모델에 파라미터가 추가된 뒤에도 예전 optimizer state를 이어붙인다.
